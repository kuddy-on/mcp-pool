MCP_POOL_ENVIRONMENT=development
MCP_POOL_HOST=127.0.0.1
MCP_POOL_PORT=8000
MCP_POOL_LOG_LEVEL=INFO
MCP_POOL_DATABASE_URL=sqlite+aiosqlite:///./mcp_pool.db
MCP_POOL_SECRET_KEY=replace-with-a-random-secret-before-production
# Required only when the users table is empty. Generate a unique value; do not commit it.
# MCP_POOL_INITIAL_ADMIN_PASSWORD=
MCP_POOL_ALLOW_ANONYMOUS_GATEWAY=false
MCP_POOL_TRUST_PROXY_HEADERS=false
MCP_POOL_ALLOW_PRIVATE_UPSTREAMS=false
# Production requires a JSON host allowlist, for example: ["api.context7.com"]
# MCP_POOL_UPSTREAM_ALLOWED_HOSTS=[]
MCP_POOL_MAX_REQUEST_BODY_BYTES=2097152
MCP_POOL_REQUEST_LOG_RETENTION_DAYS=30
